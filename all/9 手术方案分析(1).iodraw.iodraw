        <mxCell id="fBZ1fuwrNozQJeLCpybQ-55" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;PET-CT&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;显示右下&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;1-4&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;牙根方牙槽骨广泛骨质吸收并伴异常高代谢，&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;CT&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;及&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;MR&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;增强提示右侧下颌骨异常病理性改变并伴周围软组织明显肿胀，&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;MR&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;更直接提示恶性占位性病变&lt;/span&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="577.56" y="105" width="352.44" height="30" as="geometry" />
        </mxCell>
        <mxCell id="fBZ1fuwrNozQJeLCpybQ-56" value="&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;这组表现已超出普通牙周炎或慢性骨髓炎的典型影像模式，应高度警惕恶性肿瘤&lt;/font&gt;&lt;/span&gt;" style="whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1">

        <mxCell id="SqaZgHoP14FstCXms8f1-46" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;口腔检查显示&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;32-45&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;牙龈肿胀、鲜红、肉芽肿样、不贴附牙面，&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;BOP100%&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;，&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;PD&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;约&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;10-13mm&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;，提示局部存在重度炎症反应；同时&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;43&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;、&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;44&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;暂封，&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;42-46&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;近中颊侧临时夹板固定&lt;/span&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="577.56" y="-70" width="352.44" height="30" as="geometry" />

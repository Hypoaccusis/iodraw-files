        <mxCell id="fBZ1fuwrNozQJeLCpybQ-52" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;右下前牙区牙槽突呈边界清楚但边缘粗糙的破坏灶，&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;41-44&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;唇侧骨吸收至根尖、舌侧至根中&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;1/2&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;，&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;45&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;近中至根尖、远中至颈&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;1/3&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;，&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;CBCT&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;进一步证实&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;41-44&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;唇舌侧骨吸收至根尖，&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;45&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;舌侧吸收至根尖&lt;/span&gt;&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62);&quot;&gt;1/3&lt;/span&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="577.56" y="55" width="402.44" height="30" as="geometry" />
        </mxCell>
        <mxCell id="fBZ1fuwrNozQJeLCpybQ-53" value="&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62); font-size: 10px;&quot;&gt;提示病变并非局限于牙周膜间隙，而是已造成广泛牙槽骨破坏&lt;/span&gt;" style="whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1070" y="55" width="150" height="30" as="geometry" />

        <mxCell id="SqaZgHoP14FstCXms8f1-44" value="&lt;span style=&quot;font-family: 微软雅黑; color: rgb(63, 64, 62); font-size: 10px;&quot;&gt;提示病变并非单纯由菌斑驱动的普通牙周炎或典型根尖周炎所致&lt;/span&gt;" style="whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="960" y="-120" width="150" height="30" as="geometry" />
        </mxCell>
